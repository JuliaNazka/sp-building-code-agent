# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: any LangChain provider:model string works (requires that provider's package/key)
# COE_CHAT_MODEL=google_genai:gemini-3.5-flash-lite
# COE_EMBEDDING_MODEL=models/gemini-embedding-2

# Optional: Langfuse tracing (https://langfuse.com). Tracing turns on only when all three are set.
# Keys come from your Langfuse project settings; use your own host if you self-host.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # LANGFUSE_HOST also works
